  m_Script: {fileID: 11500000, guid: 6f8a1deb266fbd24685999afa55165f0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LeadersMural
  data: {fileID: 11400000, guid: 2d3b8f3edff96c54aa29fd912c962e32, type: 2}
  lostFadeAmount: 0.3
  fadeDuration: 0.5
  spawner: {fileID: 0}
  portraits:
  - title: Queen Nzinga
    story: Queen Nzinga (Njinga Mbande) ruled the kingdoms of Ndongo and Matamba,
      in what is now Angola, in the 1600s. A skilled diplomat and military leader,
      she resisted Portuguese colonial expansion for more than thirty years. She
      is remembered as a symbol of African resistance and leadership.
    narration: {fileID: 8300000, guid: 7548225b4be34b04a99877955ab99ee2, type: 3}
    lift: {fileID: 2300291280970291306}
    floater: {fileID: 1736270941504428185}
    figure: {fileID: 356079441430212103}
    glow: {fileID: 277834701893925564}
    shadow: {fileID: 3782997720652289283}
    dust: {fileID: 2761835407681643953}
    viewed: 0
    glowScale: {x: 0, y: 0, z: 0}
  - title: Mansa Musa
    story: Mansa Musa ruled the Mali Empire in the early 1300s, when it was one of
      the largest and richest states in the world. His pilgrimage to Mecca in 1324
      carried so much gold that it became famous across Africa, the Middle East and
      Europe. He built mosques and supported scholars in Timbuktu, helping it become
      a great centre of learning.
    narration: {fileID: 8300000, guid: 42fa424b0ff72994ca0151103d228898, type: 3}
    lift: {fileID: 7274706254111564895}
    floater: {fileID: 7044555635656415613}
    figure: {fileID: 7403545009031250865}
    glow: {fileID: 8202791702651234264}
    shadow: {fileID: 5615418146823201448}
    dust: {fileID: 2050475619666855968}
    viewed: 0
    glowScale: {x: 0, y: 0, z: 0}
  - title: Thomas Sankara
    story: Thomas Sankara led Burkina Faso from 1983 to 1987 and gave the country
      its name, meaning land of upright people. His government ran national vaccination
      and literacy campaigns, planted millions of trees, and promoted women's rights
      and self-reliance. He was killed in a coup in 1987, aged 37, and remains an
      icon for young Africans.
    narration: {fileID: 8300000, guid: b206fef66420dec47ad99a2ef59740de, type: 3}
    lift: {fileID: 1919966459833662872}
    floater: {fileID: 1870739283020660140}
    figure: {fileID: 6590223301116561140}
    glow: {fileID: 128263877786625099}
    shadow: {fileID: 6238556961564889527}
    dust: {fileID: 6220675980589968059}
    viewed: 0
    glowScale: {x: 0, y: 0, z: 0}
  - title: Kwame Nkrumah
    story: Kwame Nkrumah led Ghana to independence from Britain in 1957, one of the
      first African countries to win freedom from colonial rule. As Ghana's first
      prime minister and president, he championed Pan-Africanism, the idea that Africa
      should unite. He helped found the Organisation of African Unity in 1963.
    narration: {fileID: 8300000, guid: 225051f7017a4814fb0db2584ae6542e, type: 3}
    lift: {fileID: 7790285300332793820}
    floater: {fileID: 1164957782930196824}
    figure: {fileID: 3066428807415372006}
    glow: {fileID: 8518426066154215636}
    shadow: {fileID: 1593254878730771663}
    dust: {fileID: 8278246838857701780}
    viewed: 0
    glowScale: {x: 0, y: 0, z: 0}
  - title: Winnie Madikizela-Mandela
    story: Winnie Madikizela-Mandela was a South African social worker and anti-apartheid
      activist. While Nelson Mandela spent 27 years in prison, she kept the struggle
      in the public eye, despite being banned, detained and sent into internal exile.
      Many South Africans call her Mother of the Nation.
    narration: {fileID: 8300000, guid: f93d5b098e00c4c4094b80fa2d12823b, type: 3}
    lift: {fileID: 4137555130807815284}
    floater: {fileID: 8802940890420535684}
    figure: {fileID: 4106107385581999920}
    glow: {fileID: 8685696991802573497}
    shadow: {fileID: 8872145042134235715}
    dust: {fileID: 717105935614202505}
    viewed: 0
    glowScale: {x: 0, y: 0, z: 0}
